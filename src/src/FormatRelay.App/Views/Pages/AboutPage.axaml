<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FormatRelay.App.ViewModels.Pages"
             xmlns:c="using:FormatRelay.App.Controls"
             xmlns:v="using:FormatRelay.App.Views"
             x:Class="FormatRelay.App.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <UserControl.Styles>
    <!-- Wide: two equal columns with an 18 px gap (9 px either side of the middle). -->
    <Style Selector="Grid#InfoUpdateGrid > Border.info-card">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="0,0,9,0" />
    </Style>
    <Style Selector="Grid#InfoUpdateGrid > Border.update-card">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="9,0,0,0" />
    </Style>
    <!-- Narrow: stacked as before. -->
    <Style Selector="Grid#InfoUpdateGrid.stacked > Border.info-card">
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Grid#InfoUpdateGrid.stacked > Border.update-card">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="Margin" Value="0,18,0,0" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="{DynamicResource about.title}" />
    <!-- FormatRelay information and Updates sit side by side with equal widths. Below StackBelowWidth (see the code-behind)
         the grid gets the "stacked" class and the cards go back to one above the other. -->
    <Grid x:Name="InfoUpdateGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
      <Border Classes="card info-card">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
          <!-- Centered next to the text. Side by side, this card is stretched to the height of the Updates card, so a
               top-aligned logo would sit above the middle of the text. -->
          <Image Source="avares://FormatRelay/Assets/Icons/format-relay.png" Width="72" Height="72" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="Format Relay" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Launched by Code &amp; Chaos Studio" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,1,0,2" />
            <TextBlock Classes="muted" Text="Exclusive creation of 3 founder-developers. Strictly proprietary." FontSize="12" Margin="0,0,0,4" />
            <TextBlock Classes="muted" Text="{Binding Version}" />
            <TextBlock Classes="muted" Text="{DynamicResource about.license}" TextWrapping="Wrap" />
            <Button Classes="ghost" Padding="0" Click="OnOpenRepository" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Link}" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding RepositoryUrl}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
            <!-- This version's "What's new" slides again -->
            <Button x:Name="WhatsNewLink" Classes="ghost" Padding="0" Command="{Binding ShowWhatsNewCommand}" IsVisible="{Binding HasWhatsNew}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Info}" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding WhatsNewText}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border Classes="card update-card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{DynamicResource about.updates}" />
          <ToggleSwitch Content="{DynamicResource general.check_updates}" IsChecked="{Binding CheckForUpdates}" />
          <WrapPanel>
            <Button Command="{Binding CheckNowCommand}" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- Turns while the check runs (Spin.IsActive follows CheckNowCommand.IsRunning; the code is in Controls/Spin.cs). -->
                <PathIcon c:Spin.IsActive="{Binding CheckNowCommand.IsRunning}"
                          Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
                <TextBlock Text="{DynamicResource general.check_now}" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding UpdateAvailable}" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Download}" />
                <TextBlock Text="{Binding UpdateButtonText}" />
              </StackPanel>
            </Button>
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding UpdateStatus}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
    <!-- Code & Chaos Studio Identity & Anti-Cloning Card -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Code &amp; Chaos Studio (Code &amp; Share Studio)" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Format Relay is our proprietary, local-first tactical file conversion suite. All design, animations, and conversion workflows are built in-house. Strictly protected under our View-Only License — unauthorized cloning, forking, or redistribution is prohibited." />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
          <Border Classes="pill" Background="{DynamicResource AccentSoftBrush}" Padding="10,4" CornerRadius="8">
            <TextBlock Text="Team: 3 Core Developers" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
          </Border>
          <Border Classes="pill" Background="{DynamicResource AccentSoftBrush}" Padding="10,4" CornerRadius="8">
            <TextBlock Text="Tagline: We built stuff." Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
          </Border>
          <Border Classes="pill" Background="{DynamicResource AccentSoftBrush}" Padding="10,4" CornerRadius="8">
            <TextBlock Text="100% Offline / Local-First" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{DynamicResource about.support_title}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource about.support_text}" />
        <WrapPanel>
          <Button Classes="accent" Click="OnStar" Margin="0,0,8,0" Content="{DynamicResource feedback.star}" />
          <Button Click="OnIssue" Content="{DynamicResource feedback.issue}" Margin="0,0,8,0" />

        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
