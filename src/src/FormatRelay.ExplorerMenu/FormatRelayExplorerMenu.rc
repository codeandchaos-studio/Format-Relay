// Version information of the Explorer context-menu DLL. build/build-explorer-menu.ps1 passes the app version as
// FORMATRELAY_VERSION_MAJOR/MINOR/PATCH and FORMATRELAY_VERSION_TEXT.

#include <winver.h>

#ifndef FORMATRELAY_VERSION_MAJOR
#define FORMATRELAY_VERSION_MAJOR 0
#define FORMATRELAY_VERSION_MINOR 0
#define FORMATRELAY_VERSION_PATCH 0
#define FORMATRELAY_VERSION_TEXT "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION FORMATRELAY_VERSION_MAJOR, FORMATRELAY_VERSION_MINOR, FORMATRELAY_VERSION_PATCH, 0
PRODUCTVERSION FORMATRELAY_VERSION_MAJOR, FORMATRELAY_VERSION_MINOR, FORMATRELAY_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Code & Chaos Studio"
            VALUE "FileDescription", "Format Relay File Explorer context menu"
            VALUE "FileVersion", FORMATRELAY_VERSION_TEXT
            VALUE "InternalName", "FormatRelayExplorerMenu"
            VALUE "LegalCopyright", "Copyright (c) Code & Chaos Studio. MIT License."
            VALUE "OriginalFilename", "FormatRelayExplorerMenu.dll"
            VALUE "ProductName", "FormatRelay"
            VALUE "ProductVersion", FORMATRELAY_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
